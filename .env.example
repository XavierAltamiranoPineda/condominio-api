# ═══════════════════════════════════════════════════════
#  .env.example — Variables de entorno para PRODUCCIÓN
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA commitas .env al repositorio.
# ═══════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/condominio_db
DB_USERNAME=condominio_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ────────────────────────────────────────────────
# Genera con: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_MINIMUM_256_BITS_BASE64_ENCODED_SECRET
JWT_ACCESS_EXP=900000
JWT_REFRESH_EXP=604800000

# ── CORS ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://app.tudominio.com

# ── Servidor ──────────────────────────────────────────
PORT=8080
